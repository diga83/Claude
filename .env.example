# Required in production: a random string of at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Optional: enables the AI second opinion (hybrid mode). Without it the app
# runs on statistical analysis only.
ANTHROPIC_API_KEY=

# Optional: override the model used for the AI second opinion.
# DETECTOR_MODEL=claude-opus-5-5

# Optional: defaults to a local SQLite file at ./data/app.db.
# For production use a hosted libSQL/Turso database:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
