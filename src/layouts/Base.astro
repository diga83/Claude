---
import { SITE } from "../config.js";
import { icon } from "../lib/icons.js";
import { CATEGORIES, categoryUrl } from "../lib/data.js";
import Logo from "../components/Logo.astro";
import "../styles/global.css";

const {
  title = SITE.name,
  description = SITE.description,
  ogType = "website",
  jsonLd = null
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const currentPath = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta name="twitter:card" content="summary" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.name} blog`} href="/rss.xml" />
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("ce-theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) { document.documentElement.setAttribute("data-theme", "light"); }
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 104'%3E%3Cpolygon points='26,44 17,8 50,24' fill='%23191114' stroke='%23191114' stroke-width='7' stroke-linejoin='round'/%3E%3Cpolygon points='94,44 103,8 70,24' fill='%23191114' stroke='%23191114' stroke-width='7' stroke-linejoin='round'/%3E%3Cpolygon points='28,36 23,17 43,27' fill='%23ed4e8c'/%3E%3Cpolygon points='92,36 97,17 77,27' fill='%23ed4e8c'/%3E%3Cellipse cx='60' cy='56' rx='39' ry='34' fill='%23191114'/%3E%3Cpath d='M34 54 Q45 45 56 54 Q45 63 34 54 Z' fill='white'/%3E%3Cpath d='M64 54 Q75 45 86 54 Q75 63 64 54 Z' fill='white'/%3E%3Ccircle cx='46' cy='54' r='4' fill='%23191114'/%3E%3Ccircle cx='74' cy='54' r='4' fill='%23191114'/%3E%3Cpath d='M60 78 C53 71 49 67 52.5 62.5 C55.5 59 60 62 60 65.5 C60 62 64.5 59 67.5 62.5 C71 67 67 71 60 78 Z' fill='%23ed4e8c'/%3E%3C/svg%3E" />
  {SITE.adsenseEnabled && SITE.adsenseClient && (
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`} crossorigin="anonymous" is:inline></script>
  )}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
        <Logo />
      </a>
      <nav class="nav-links" aria-label="Main navigation">
        <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>Topics</a>
        <a href="/blog/" aria-current={currentPath.startsWith("/blog") ? "page" : undefined}>Blog</a>
        <a href="/about/" aria-current={currentPath.startsWith("/about") ? "page" : undefined}>About</a>
      </nav>
      <div class="header-actions">
        <button class="search-trigger" type="button" data-open-palette aria-label="Search the encyclopedia">
          <span set:html={icon("search")} />
          <span class="label">Search&hellip;</span>
          <span class="kbd-hint"><kbd>&#8984;</kbd><kbd>K</kbd></span>
        </button>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle dark mode"></button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h3>{SITE.name}</h3>
          <p>Hundreds of answers across every corner of cat life — searchable, linkable, and free.</p>
          <ul>
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
            <li><a href="/privacy/">Privacy policy</a></li>
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </div>
        <div>
          <h3>Topics</h3>
          <ul style="columns: 2; column-gap: 1.5rem;">
            {CATEGORIES.map((cat) => (
              <li><a href={categoryUrl(cat)}>{cat.name}</a></li>
            ))}
          </ul>
        </div>
      </div>
      <p class="footer-note">
        This encyclopedia is general educational information, not veterinary advice. For any health
        concern, medication question, or emergency, consult a licensed veterinarian. US poison
        hotlines: ASPCA Animal Poison Control (888)&nbsp;426-4435 &middot; Pet Poison Helpline (855)&nbsp;764-7661.
      </p>
    </div>
  </footer>

  <script src="/scripts/site.js" defer is:inline></script>
</body>
</html>
