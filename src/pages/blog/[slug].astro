---
import Base from "../../layouts/Base.astro";
import AdSlot from "../../components/AdSlot.astro";
import Comments from "../../components/Comments.astro";
import { SITE } from "../../config.js";
import { icon } from "../../lib/icons.js";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateFmt = { year: "numeric", month: "long", day: "numeric" };

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  ...(post.data.heroImage && { image: new URL(post.data.heroImage, SITE.url).href }),
  author: { "@type": "Organization", name: SITE.name },
  publisher: { "@type": "Organization", name: SITE.name },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, SITE.url).href
};
---
<Base title={`${post.data.title} — ${SITE.name}`} description={post.data.description} ogType="article" jsonLd={jsonLd}>
  <div class="container prose">
    <div class="category-hero" style="padding-bottom: 0;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> &nbsp;/&nbsp; <a href="/blog/">Blog</a> &nbsp;/&nbsp; {post.data.title}
      </nav>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <span><span set:html={icon("calendar")} />{post.data.pubDate.toLocaleDateString("en-US", dateFmt)}</span>
        {post.data.updatedDate && <span>Updated {post.data.updatedDate.toLocaleDateString("en-US", dateFmt)}</span>}
      </p>
      {post.data.tags.length > 0 && (
        <div class="tag-row">
          {post.data.tags.map((t) => <span class="tag-chip">{t}</span>)}
        </div>
      )}
    </div>

    {post.data.heroImage && (
      <div class="post-hero">
        <img src={post.data.heroImage} alt="" />
      </div>
    )}

    <article class="prose-body">
      <Content />
    </article>

    <AdSlot slot="" />

    <Comments path={`/blog/${post.id}/`} />

    <nav class="cat-nav" aria-label="Blog navigation" style="margin-top: 2rem;">
      <a href="/blog/"><span set:html={icon("arrowLeft")} />All posts</a>
      <a href="/">Browse the encyclopedia<span set:html={icon("arrowRight")} /></a>
    </nav>
  </div>
</Base>
