---
/* kittydrama.com logo lockup — vector recreation of the brand logo.
   Dark parts use currentColor so the mark adapts to the theme. */
---
<span class="brand-logo" aria-hidden="true">
  <svg viewBox="0 0 120 104" role="img">
    <!-- tail swoosh -->
    <path class="lg-dark" d="M16 78 C4 86 6 99 22 98 C44 97 66 99 86 92 C97 88 106 90 110 96"
      fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
    <!-- ears -->
    <polygon class="lg-dark" points="26,44 17,8 50,24" fill="currentColor" stroke="currentColor" stroke-width="7" stroke-linejoin="round" />
    <polygon class="lg-dark" points="94,44 103,8 70,24" fill="currentColor" stroke="currentColor" stroke-width="7" stroke-linejoin="round" />
    <polygon class="lg-pink" points="28,36 23,17 43,27" />
    <polygon class="lg-pink" points="92,36 97,17 77,27" />
    <!-- head -->
    <ellipse class="lg-dark" cx="60" cy="56" rx="39" ry="34" fill="currentColor" />
    <!-- whiskers -->
    <g class="lg-dark" stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <path d="M24 60 L4 56" /><path d="M25 68 L6 68" />
      <path d="M96 60 L116 56" /><path d="M95 68 L114 68" />
    </g>
    <!-- sassy half-lidded eyes (cut out in page background colour) -->
    <path class="lg-eye" d="M34 54 Q45 45 56 54 Q45 63 34 54 Z" />
    <path class="lg-eye" d="M64 54 Q75 45 86 54 Q75 63 64 54 Z" />
    <circle class="lg-dark" cx="46" cy="54" r="4" fill="currentColor" />
    <circle class="lg-dark" cx="74" cy="54" r="4" fill="currentColor" />
    <!-- heart nose -->
    <path class="lg-pink" d="M60 78 C53 71 49 67 52.5 62.5 C55.5 59 60 62 60 65.5 C60 62 64.5 59 67.5 62.5 C71 67 67 71 60 78 Z" />
    <!-- collar -->
    <rect class="lg-pink" x="42" y="86" width="36" height="8" rx="4" />
  </svg>
</span>
<span class="brand-word">k<span class="brand-i">&#305;</span>ttydrama<span class="brand-tld">.com</span></span>
