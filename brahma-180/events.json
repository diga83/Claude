{"dur":180,"ev":[{"t":0.3,"type":"bloom","g":1},{"t":1,"type":"voice","id":"v01"},{"t":1,"type":"sub","d":5.537,"text":"In the beginning, the old stories say, there was only dark water, and on it, a golden egg."},{"t":2,"type":"brush","d":3.6,"g":0.4,"pan0":-0.4,"pan1":0.4},{"t":2.5,"type":"deep","d":32},{"t":7.4,"type":"voice","id":"v02"},{"t":7.4,"type":"sub","d":2.236,"text":"Hiranyagarbha. The golden womb."},{"t":11.6,"type":"voice","id":"v03"},{"t":11.6,"type":"sub","d":7.857,"text":"When it broke, one half became the sky, and the other, the earth. And the one who woke inside was Brahma, the creator."},{"t":11.9,"type":"crack"},{"t":12.8,"type":"swell","d":3},{"t":13.2,"type":"brush","d":2.6,"g":0.45,"pan0":-0.8,"pan1":0.8},{"t":14,"type":"brush","d":2.2,"g":0.4,"pan0":0.6,"pan1":-0.4},{"t":16.2,"type":"brush","d":2.8,"g":0.45},{"t":19,"type":"glock","p":"D6"},{"t":20.8,"type":"voice","id":"v04"},{"t":20.8,"type":"sub","d":7.989,"text":"He has four faces, so that he sees in every direction at once. From each of his four mouths came one of the four Vedas."},{"t":24,"type":"brush","d":0.7,"g":0.35,"pan0":0,"pan1":0},{"t":24,"type":"glock","p":"F#6"},{"t":24.8,"type":"brush","d":0.7,"g":0.35,"pan0":0.7,"pan1":0.8},{"t":24.8,"type":"glock","p":"A6"},{"t":25.6,"type":"brush","d":0.7,"g":0.35,"pan0":0,"pan1":0},{"t":25.6,"type":"glock","p":"B6"},{"t":26.4,"type":"brush","d":0.7,"g":0.35,"pan0":-0.7,"pan1":-0.8},{"t":26.4,"type":"glock","p":"D7"},{"t":28.6,"type":"pencil","d":1.1},{"t":35,"type":"brush","d":2.2,"g":0.35},{"t":35,"type":"night","d":17},{"t":35.2,"type":"brush","d":1.2,"g":0.45,"pan0":-0.9,"pan1":0.9},{"t":37.2,"type":"voice","id":"s1"},{"t":37.2,"type":"sub","d":6.72,"text":"From his mind, he brought forth sons. Among them were the seven great sages, the Saptarishi."},{"t":38.6,"type":"star","i":0},{"t":39.4,"type":"star","i":1},{"t":40.2,"type":"star","i":2},{"t":41,"type":"star","i":3},{"t":41.8,"type":"star","i":4},{"t":42.6,"type":"star","i":5},{"t":43.4,"type":"star","i":6},{"t":44.6,"type":"brush","d":1.6,"g":0.25,"pan0":-0.6,"pan1":0.6},{"t":45.4,"type":"voice","id":"s2"},{"t":45.4,"type":"sub","d":4.2,"text":"Their light still turns above us, in the seven stars of the Great Bear."},{"t":54.4,"type":"brush","d":1.2,"g":0.45,"pan0":-0.9,"pan1":0.9},{"t":56,"type":"voice","id":"v05"},{"t":56,"type":"sub","d":3.62,"text":"In his four hands, he holds what a world needs to begin."},{"t":59.8,"type":"brush","d":1.2,"g":0.35},{"t":60.2,"type":"voice","id":"h1"},{"t":60.2,"type":"sub","d":2.209,"text":"A water pot, for the waters of life."},{"t":62,"type":"pour","d":2.6},{"t":62.4,"type":"pencil","d":0.9},{"t":68,"type":"brush","d":1.2,"g":0.35},{"t":68,"type":"bead","i":0},{"t":68.18,"type":"bead","i":1},{"t":68.36,"type":"bead","i":2},{"t":68.4,"type":"voice","id":"h2"},{"t":68.4,"type":"sub","d":2.39,"text":"A string of beads, to count out time."},{"t":68.54,"type":"bead","i":3},{"t":68.72,"type":"bead","i":4},{"t":68.9,"type":"bead","i":5},{"t":69.08,"type":"bead","i":6},{"t":69.26,"type":"bead","i":7},{"t":69.44,"type":"bead","i":8},{"t":69.62,"type":"bead","i":9},{"t":69.8,"type":"bead","i":10},{"t":69.98,"type":"bead","i":11},{"t":70.16,"type":"bead","i":12},{"t":70.34,"type":"bead","i":13},{"t":70.52,"type":"bead","i":14},{"t":70.6,"type":"pencil","d":0.9},{"t":70.7,"type":"bead","i":15},{"t":70.88,"type":"bead","i":16},{"t":71.06,"type":"bead","i":17},{"t":71.24,"type":"bead","i":18},{"t":71.42,"type":"bead","i":19},{"t":71.6,"type":"bead","i":20},{"t":71.78,"type":"bead","i":21},{"t":71.96,"type":"bead","i":22},{"t":72.14,"type":"bead","i":23},{"t":72.32,"type":"bead","i":24},{"t":72.5,"type":"bead","i":25},{"t":72.68,"type":"bead","i":26},{"t":72.86,"type":"bead","i":27},{"t":73.04,"type":"bead","i":28},{"t":73.22,"type":"bead","i":29},{"t":76.2,"type":"brush","d":1.2,"g":0.35},{"t":76.4,"type":"voice","id":"h3"},{"t":76.4,"type":"sub","d":2.069,"text":"The sacred Vedas, for knowledge."},{"t":78.8,"type":"pencil","d":0.9},{"t":84.2,"type":"brush","d":1.2,"g":0.35},{"t":84.4,"type":"voice","id":"h4"},{"t":84.4,"type":"sub","d":3.009,"text":"And a lotus, for all that grows pure from the mud."},{"t":86.8,"type":"pencil","d":0.9},{"t":89.6,"type":"brush","d":1.2,"g":0.45,"pan0":-0.9,"pan1":0.9},{"t":90,"type":"water","d":14},{"t":91.4,"type":"voice","id":"v06"},{"t":91.4,"type":"sub","d":7.172,"text":"His mount is the swan, which is said to separate milk from water: the gift of telling the true from the false."},{"t":92.2,"type":"wings"},{"t":93.8,"type":"swirl","d":5.4},{"t":99.4,"type":"voice","id":"v07"},{"t":99.4,"type":"sub","d":5.061,"text":"Saraswati, goddess of knowledge and music, rides the same white swan."},{"t":99.8,"type":"brush","d":1.6,"g":0.35,"pan0":0.3,"pan1":0.7},{"t":104.6,"type":"mist","d":2.2},{"t":106.6,"type":"night","d":18.6},{"t":107.2,"type":"voice","id":"k1"},{"t":107.2,"type":"sub","d":8.168,"text":"One flower carries his name. High in the Himalaya, the Brahma kamal opens at night, in the brief summer of the mountains."},{"t":107.4,"type":"brush","d":1.2,"g":0.35},{"t":107.6,"type":"pencil","d":1.2},{"t":108.2,"type":"brush","d":1.6,"g":0.3,"pan0":-0.4,"pan1":0.2},{"t":109,"type":"brush","d":3,"g":0.4,"pan0":-0.3,"pan1":0.3},{"t":110.6,"type":"pencil","d":1.1},{"t":114,"type":"pencil","d":0.8},{"t":116.6,"type":"voice","id":"k2"},{"t":116.6,"type":"sub","d":5.545,"text":"It grows between 3,000 and 4,800 metres, where little else can bloom."},{"t":117.4,"type":"brush","d":1.4,"g":0.3,"pan0":0.5,"pan1":0.5},{"t":123.8,"type":"mist","d":2},{"t":126,"type":"voice","id":"v08"},{"t":126,"type":"sub","d":6.944,"text":"One day of Brahma lasts 4,320,000,000 years, and his night is just as long."},{"t":126.4,"type":"brush","d":1,"g":0.45},{"t":133.6,"type":"voice","id":"v09"},{"t":133.6,"type":"sub","d":3.929,"text":"He lives for a hundred such years. And then the universe rests."},{"t":133.8,"type":"burst"},{"t":137,"type":"brush","d":1.8,"g":0.5,"pan0":0,"pan1":0},{"t":139.4,"type":"voice","id":"v10"},{"t":139.4,"type":"sub","d":9.052,"text":"Few temples are built for him. The best known stands at Pushkar, in Rajasthan, beside a lake said to have formed where his lotus fell."},{"t":139.748,"type":"brush","d":1.6,"g":0.35,"pan0":-0.8,"pan1":0.8},{"t":139.748,"type":"lake","d":40.25185185185185},{"t":141.644,"type":"brush","d":1.6,"g":0.35},{"t":144.015,"type":"brush","d":1.6,"g":0.3,"pan0":-0.6,"pan1":-0.2},{"t":145.911,"type":"brush","d":2.4,"g":0.4,"pan0":0.3,"pan1":0.5},{"t":149.6,"type":"voice","id":"p1"},{"t":149.6,"type":"sub","d":6.59,"text":"Pilgrims come to bathe at its 52 ghats, most of all at the full moon of Kartik, in the autumn."},{"t":157.2,"type":"templebell"},{"t":158.4,"type":"voice","id":"v11"},{"t":158.4,"type":"sub","d":8.224,"text":"And the hour before dawn still carries his name: Brahma muhurta, the creator's hour, when the world is about to begin again."},{"t":164.696,"type":"birds","d":14.34782608695653},{"t":167.374,"type":"tbell"},{"t":168,"type":"voice","id":"m1"},{"t":168,"type":"sub","d":6.964,"text":"It begins about an hour and a half before sunrise: a time kept for quiet, for study, and for prayer."}]}